{
  "schemaVersion": 1,
  "id": "dragonminez",
  "version": "${version}",
  "name": "DragonMineZ",
  "description": "DragonMineZ 2.2 port for Minecraft 26.1.2 Fabric.",
  "authors": ["Yuseix300", "ezShokkoh"],
  "contributors": ["lueefr"],
  "contact": {
    "homepage": "https://dragonminez.com/",
